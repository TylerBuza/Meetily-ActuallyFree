{
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": ["templates/*.json", "resources/diarization/*"],
    "externalBin": ["binaries/llama-helper", "binaries/meetily-ffmpeg"],
    "linux": {
      "deb": {
        "depends": ["libpulse0", "libasound2t64 | libasound2", "libgomp1", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
