{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Meetily - Actually Free",
    "version": "0.2.10",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "node node_modules/next/dist/bin/next build"
    },
    "app": {
        "windows": [
            {
                "title": "Meetily - Actually Free",
                "width": 1100,
                "height": 700,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "theme": "Dark",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": [
                        "main",
                        "minibar"
                    ],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-set-theme",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "dialog:allow-save",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "updater:default",
                        "process:default",
                        {
                            "identifier": "fs:scope",
                            "allow": [
                                {
                                    "path": "$APPDATA/*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "templates/*.json",
            "resources/diarization/*",
            "runtime-deps/*",
            "installer-variants/*"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1",
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": false,
                "template": "./windows/installer.nsi",
                "installerHooks": "./windows/installer-hooks.nsh",
                "installerIcon": "./icons/icon.ico",
                "languages": ["English"],
                "customLanguageFiles": {
                    "English": "./windows/English.nsh"
                }
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MjA0M0FCMkRCNzM2QUIKUldTck5yY3RxME1nZFZmNTlaSFpLYVYxelh1RFp6cE9lOFZ2VkE0VlFXdThWUzRUK091c2ZQQ3AK",
            "endpoints": [
                "https://github.com/TylerBuza/Meetily-ActuallyFree/releases/latest/download/latest.json"
            ]
        }
    }
}
